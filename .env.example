# 复制成 .env 并填入自己的 key（.env 已被 .gitignore 忽略，不会提交）
#     cp .env.example .env
# run.sh 会自动加载，无需改动 ~/.zshrc 或 ~/.bashrc。

# 价格数据（强烈建议）。免费，500 req/小时，已做拆股与分红复权。
# 申请: https://www.tiingo.com/
TIINGO_API_KEY=

# 宏观数据（网络挡了 fred.stlouisfed.org 时必需）。
# 官方 API 在 api.stlouisfed.org，是另一个主机名，往往仍然可达。
# 跑 ./run.sh netcheck 可确认。申请（填邮箱即得）:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 可选：Reddit 情绪（实时增强层，不参与回测）
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
